# 复制为 .env 后按需修改：cp .env.example .env
# 说明：这里的值只被 docker compose 用来做变量替换并注入容器，
# 应用本身读的是 compose 传进去的环境变量（config.py 的 env_file=".env" 是给本地直跑用的）。

# ---- 必改 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生产环境沿用开发默认密钥会导致任何人都能伪造令牌，启动时会被校验拦下
SECRET_KEY=please-change-me-to-a-long-random-string

# 初始管理员用户名（会被自动提升为管理员）
BOOTSTRAP_ADMIN=zhangsan

# ---- 数据库 ----
DB_NAME=flowmart
DB_USER=flowmart
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 可选 ----
# 本地 HTTP 访问时若浏览器不接受 Secure Cookie，可改为 true（会跳过 COOKIE_SECURE 等生产校验）
# DEBUG=true
