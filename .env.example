# 复制为 .env 后按需修改：cp .env.example .env
# 说明：这里的值只被 docker compose 用来做变量替换并注入容器，
# 应用本身读的是 compose 传进去的环境变量（config.py 的 env_file=".env" 是给本地直跑用的）。

# ---- 必改 ----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 生产环境沿用开发默认密钥会导致任何人都能伪造令牌，启动时会被校验拦下
SECRET_KEY=please-change-me-to-a-long-random-string

# 初始管理员用户名（会被自动提升为管理员）
BOOTSTRAP_ADMIN=zhangsan

# ---- 数据库 ----
DB_NAME=flowmart
DB_USER=flowmart
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---- 验证码投递（邮件 / 短信）----
# 本项目开源，**不替你选厂商**：只定义「怎么连出去」，账号全部由你填。
# 默认值 console 会把验证码打到容器日志里，因此 DEBUG=false 时启动校验会拒绝，
# 必须至少把下面两个渠道配好（这正是为了防止「上线了但没人收得到码」）。
#
# 邮件（任意 SMTP 服务商均可，用标准库 smtplib，零额外依赖）：
OTP_EMAIL_SENDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@your-domain.com
# 465 端口改用 SSL 直连时：SMTP_PORT=465 + SMTP_USE_SSL=true + SMTP_STARTTLS=false

# 短信（通用 HTTP 网关，不内置任何一家 SDK）：
# 把下面这个 URL 指向你的服务商即可；也可以指向自己写的一小段转发服务，
# 那样想接谁就接谁，不用等本项目支持。报文模板里的占位符：
#   {target} 收信号码   {code} 验证码   {ttl} 有效秒数
OTP_SMS_SENDER=webhook
SMS_WEBHOOK_URL=https://sms.example.com/send
SMS_WEBHOOK_METHOD=POST
SMS_WEBHOOK_BODY={"to":"{target}","text":"您的验证码是 {code}，{ttl} 秒内有效"}
# 额外请求头（JSON 字符串），例：{"Authorization":"Bearer xxx"}
SMS_WEBHOOK_HEADERS=

# 仅端到端验收用：e2e_acceptance.py 是直接从库里读验证码的，没有真实渠道，
# 此时才置 true 并把两个渠道都设为 console。**正式部署必须 false**。
# OTP_ALLOW_CONSOLE_IN_PROD=false

# ---- 支付渠道（可插拔）----
# mock（默认，不接真实渠道）/ wechat（微信支付 v3 Native 扫码）/ alipay（支付宝电脑网站支付）
PAYMENT_PROVIDER=mock
# 站点公网基址（单一事实来源，见下方「域名 / 部署环境 / TLS」）。
# 渠道回调地址留空时会回退到这里，域名只配一次就够了。
PUBLIC_BASE_URL=https://shop.your-domain.com
# 非 mock 时必填：渠道回调的公网基址，必须 https（这是「钱到账」的唯一通知路径）。
# 留空=用上面的 PUBLIC_BASE_URL。
# PAYMENT_NOTIFY_BASE_URL=https://shop.your-domain.com
# 微信：WECHAT_APPID / WECHAT_MCHID(商户号) / WECHAT_API_V3_KEY / WECHAT_MCH_CERT_SERIAL_NO
#       / WECHAT_PRIVATE_KEY_PATH / WECHAT_PLATFORM_CERT_PATH（pem 路径，用卷挂进容器）
# 支付宝：ALIPAY_APPID / ALIPAY_PRIVATE_KEY_PATH / ALIPAY_PUBLIC_KEY_PATH

# ---- 域名 / 部署环境 / TLS ----
DEPLOY_ENV=production
# 前后端分处不同子域（如 api.example.com 与 shop.example.com）时设为 .example.com，
# 否则令牌 Cookie 不会跨子域携带，登录态在子域间失效。同源部署留空即可。
# COOKIE_DOMAIN=.your-domain.com
# 反向代理（Nginx/Caddy 等）信任开关：它已用真实客户端 IP / 协议覆写
# X-Forwarded-For / X-Forwarded-Proto 时才开 true；直连或客户端可控这两个头时务必 false，
# 否则攻击者可伪造 XFF 绕过限流、骗过 TLS 判定。
TRUST_PROXY=false
# 强制 HTTPS：把非 https 请求 307 跳到 https。**反代后必须 TRUST_PROXY=true**，否则代理
# 转发来的 http 请求会被无限重定向。下面这条只在「容器自己终止 TLS」时用得上；
# 更常见的做法是 TLS 在反代层做、这里保持 false。
ENFORCE_HTTPS=false
# HSTS：https 响应加 Strict-Transport-Security（max-age 秒），0 = 不发。生产建议 31536000。
HSTS_MAX_AGE=31536000

# ---- 可选 ----
# 本地 HTTP 访问时若浏览器不接受 Secure Cookie，可改为 true（会跳过 COOKIE_SECURE 等生产校验）
# DEBUG=true
