# ============================================================================
# flowmart 配置参考（.env.example）
# 复制为 .env 后按需修改：cp .env.example .env
#
# 说明：这里的值被 docker compose 用来做变量替换并注入容器；应用本身读的是
# compose 传进去的环境变量（config.py 的 env_file=".env" 是给本地直跑用的）。
# 所有默认值都集中在 backend/app/core/config.py，本文件列出**可调项**并标注生产必改项。
#
# 两条跑起来的路径：
#   1) 本地零凭据开发：把 DEBUG=true、PAYMENT_PROVIDER=mock、OTP_SENDER=console，
#      无需任何外部账号即可把注册/验证/下单/支付全流程跑通。
#   2) 生产部署：按下文「必改」逐项填好，启动时会做一组强校验，配错直接报错退出
#      （绝不悄悄裸奔）。
# ============================================================================

# ---- 必改（生产强校验会拦）----
# SECRET_KEY：生成方式 python -c "import secrets; print(secrets.token_urlsafe(48))"
# 沿用开发默认密钥会导致任何人都能伪造令牌，启动时会被校验拦下。
SECRET_KEY=please-change-me-to-a-long-random-string

# 初始管理员用户名（首次 seed / 迁移时自动提升为管理员）。生产务必改成真实账号。
BOOTSTRAP_ADMIN=zhangsan

# DEBUG：生产必须 false（开着意味着堆栈/文档全开、密钥校验全关）。
# 本地零凭据调试可设 true，但那会同时跳过全部生产强校验，仅限开发。
DEBUG=false

# 部署环境标签，仅出现在 /health 便于区分跑的是哪套；production 必须与 DEBUG=false 同号。
DEPLOY_ENV=production

# ---- JWT / Cookie ----
# 访问令牌过期分钟（过期靠 /auth/refresh 静默续期，故可设短）。生产可调。
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌有效期（天），独立 httpOnly Cookie，仅用于换发访问令牌。
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_COOKIE_NAME=fm_token
REFRESH_TOKEN_COOKIE_NAME=fm_refresh
# 生产必须 true：HttpOnly Cookie 仅经 HTTPS 下发，否则经明文 HTTP 泄露会话令牌。
COOKIE_SECURE=true
# lax 兼容同站前端；strict 抗 CSRF 更强（但跨站跳转回站会丢登录态）。
COOKIE_SAMESITE=lax
# 前后端分处不同子域（如 api.example.com 与 shop.example.com）时设为 .example.com，
# 否则令牌 Cookie 不会跨子域携带，登录态在子域间失效。同源部署留空即可。
# COOKIE_DOMAIN=.your-domain.com
# 允许的前端跨域源（仅放行已知源，禁止 *）。JSON 数组写法。
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---- 数据库 ----
# 方言：sqlite（默认，单文件零依赖便于本地看数据）/ mysql（生产）。
# 用 sqlite 本地零凭据跑：DB_DIALECT=sqlite（SQLITE_PATH 留空则落在项目根 flowmart.db）。
DB_DIALECT=mysql
# 直接用完整连接串优先级最高（连特殊环境时填），填了下面 MySQL 参数忽略。
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/flowmart?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flowmart
DB_PASSWORD=change-me-db-password
DB_NAME=flowmart
# 仅 SQLite 用：留空默认项目根 flowmart.db。
# SQLITE_PATH=flowmart.db
# 打印 SQL（调试用，生产关）。
DB_ECHO=false

# ---- 验证码 / 通知（开源，不替你选厂商）----
# 位数与有效期；确认尝试上限防对 6 位码暴力枚举；重发限流（基于 DB，多实例安全）。
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_CONFIRM_MAX_ATTEMPTS=5
OTP_RESEND_WINDOW=60
OTP_MAX_PER_WINDOW=5
# 生产必须 false：否则发送接口把验证码明文回传给客户端，等于没验证。
OTP_DEV_RETURN_CODE=false
# 发送器：console | smtp | webhook。
# 全局默认 OTP_SENDER，单渠道可用 OTP_EMAIL_SENDER / OTP_SMS_SENDER 覆盖
# （邮件只能 smtp/console，短信只能 webhook/console）。
# 本地零凭据开发把三者都设 console 即可跑通注册验证。
OTP_SENDER=console
# 端到端验收（脚本直接从库里读码，无真实渠道）时唯一允许 console 的情形；正式部署必须 false。
# OTP_ALLOW_CONSOLE_IN_PROD=false

# 邮件（任意 SMTP 服务商，标准库 smtplib，零额外依赖）：
OTP_EMAIL_SENDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@your-domain.com
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# 短信（通用 HTTP 网关，不内置任何一家 SDK）：
OTP_SMS_SENDER=webhook
SMS_WEBHOOK_URL=https://sms.example.com/send
SMS_WEBHOOK_METHOD=POST
SMS_WEBHOOK_BODY={"to":"{target}","text":"您的验证码是 {code}，{ttl} 秒内有效"}
# 额外请求头（JSON 对象），例：{"Authorization":"Bearer xxx"}；留空不加。
SMS_WEBHOOK_HEADERS=
SMS_WEBHOOK_TIMEOUT=10
SMS_SUCCESS_MIN_STATUS=200
SMS_SUCCESS_MAX_STATUS=299

# ---- 支付渠道（可插拔，配置驱动）----
# mock（默认，不接真实渠道）/ wechat（微信支付 v3 Native 扫码）/ alipay（支付宝电脑网站支付）。
# 非 mock 时以下凭据缺任一即启动报错（配错只会在用户付款那步才暴露，最难查）。
PAYMENT_PROVIDER=mock
# 站点公网基址（单一事实来源）：支付回调地址留空时回退它，域名只配一次。必须 https://。
PUBLIC_BASE_URL=https://shop.your-domain.com
# 渠道回调公网基址（钱到账的唯一通知路径），必须 https；留空=用 PUBLIC_BASE_URL。
# PAYMENT_NOTIFY_BASE_URL=https://shop.your-domain.com
# 微信：WECHAT_APPID / WECHAT_MCHID / WECHAT_API_V3_KEY / WECHAT_MCH_CERT_SERIAL_NO
#       / WECHAT_PRIVATE_KEY_PATH / WECHAT_PLATFORM_CERT_PATH（pem 路径，用卷挂进容器）。
# 支付宝：ALIPAY_APPID / ALIPAY_PRIVATE_KEY_PATH / ALIPAY_PUBLIC_KEY_PATH；
#       ALIPAY_SIGN_TYPE=RSA2；ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ---- 待付款订单超时回收（库存防泄漏）----
# 超过该分钟数的待付款订单由 scripts/expire_unpaid_orders.py 取消并归还库存；<=0 不启用。
ORDER_PAY_TIMEOUT_MINUTES=30

# ---- 限流（防爆破 / 灌账号 / 验证码轰炸 / 刷单 / 磁盘 DoS）----
# 登录失败限流：同一 (IP, 用户名) 在窗口内失败超阈值即拒。
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=60
# 多实例共享计数（INCR+EXPIRE 原子）：非空启用 Redis，限流对全部实例统一生效。
# 例如 "redis://127.0.0.1:6379/0"；连不上启动即报错（fail-fast）。单实例留空用进程内内存。
LOGIN_RATE_LIMIT_REDIS_URL=
# 各 scope 的每 IP / 每 user_id 上限（窗口统一 RATE_LIMIT_WINDOW 秒，0=关闭该 scope）：
RATE_LIMIT_REGISTER_MAX=5       # 每 IP 注册
RATE_LIMIT_CODE_MAX=5           # 每 IP 发码（验证 / 找回密码）
RATE_LIMIT_LOGIN_MAX=30         # 每 IP 登录请求量（防 PBKDF2 CPU 放大 DoS）
RATE_LIMIT_OTP_MAX=10            # 每 (IP, 用户名) OTP 确认猜测上限
RATE_LIMIT_ORDER_MAX=20         # 每 user_id 下单 / 结算（防刷单打光库存）
RATE_LIMIT_UPLOAD_MAX=30        # 每 user_id 上传（防磁盘 DoS）
RATE_LIMIT_PAYMENT_CALLBACK_MAX=60  # 每 IP 支付回调（验签前拦截 CPU 放大 DoS）
RATE_LIMIT_WINDOW=60

# ---- 图片上传（商品封面等）----
# 本地磁盘 + 静态挂载，零外部依赖；换 OSS/S3 只需替换 api/uploads.py 的写入逻辑。
# UPLOAD_DIR 默认项目根 uploads/（容器内建议挂卷，如 /data/uploads）。
# UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=2097152            # 单文件 2MB
UPLOAD_TOTAL_MAX_BYTES=536870912   # 目录总量 512MB（单文件上限挡不住慢慢攒满磁盘）
UPLOAD_ORPHAN_RETENTION_SECONDS=86400  # 孤儿保留 24h（上传与保存表单是两次请求）

# ---- 域名 / 部署环境 / TLS ----
# 反向代理（LB / Caddy 等）信任开关：代理已用真实客户端 IP / 协议覆写
# X-Forwarded-For / X-Forwarded-Proto 时才开 true；直连或客户端可控这两个头时务必 false，
# 否则攻击者可伪造 XFF 绕过限流、骗过 TLS 判定。
TRUST_PROXY=false
# 强制 HTTPS：把非 https 请求 307 跳到 https。**反代后必须 TRUST_PROXY=true**，
# 否则代理转发来的 http 会被无限重定向。TLS 在反代层做时这里保持 false。
ENFORCE_HTTPS=false
# HSTS：https 响应加 Strict-Transport-Security（max-age 秒），0 = 不发。生产建议 31536000。
HSTS_MAX_AGE=31536000
